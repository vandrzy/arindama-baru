// Prisma Schema for ARINDAMA Survey Application
// Database: PostgreSQL
// Setup: Production-ready dengan enkripsi password & audit logging

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String   // Hashed with bcrypt
  nama        String
  role        UserRole @default(RESPONDEN)
  jabatan       String   @default("")
  kabupatenKota String   @default("")
  instansi      String   @default("")
  
  // Relations
  submissions Submission[]
  auditLogs   AuditLog[]
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
  
  @@index([email])
  @@index([username])
  @@map("users")
}

enum UserRole {
  ADMIN
  RESPONDEN
}

// ============================================
// SURVEY SUBMISSIONS
// ============================================

model Submission {
  id                  String           @id @default(cuid())
  noRegistrasi        String           @unique @default(dbgenerated("gen_random_uuid()"))
  userId              String
  tahunSurvei         Int              @default(2024)
  totalIndikatorTerisi Int             @default(0)
  
  // Relations
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  respondenIdentity   RespondenIdentity?
  indicatorRecords    IndicatorRecord[]
  validationEvidences ValidationEvidence[]
  
  // Timestamps
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  
  @@index([userId])
  @@index([tahunSurvei])
  @@map("submissions")
}

// ============================================
// RESPONDEN IDENTITY (Form Identitas Responden)
// ============================================

model RespondenIdentity {
  id                  String     @id @default(cuid())
  submissionId        String     @unique
  namaLengkap         String
  jenisKelamin        String
  tanggalLahir        String
  umur                String
  kabupatenKotaAsal   String
  kecamatan           String
  pekerjaanJabatan    String
  nomorTelepon        String

  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("responden_identities")
}

// ============================================
// INDICATOR RECORDS (Form Indikator 1 - 8)
// ============================================

model IndicatorRecord {
  id                      String     @id @default(cuid())
  submissionId            String
  indicatorId             Int        // 1 - 8
  namaKegiatan            String
  cabangOlahraga          String
  tingkatPenyelenggaraan  String
  sumberPendanaan         String
  medali                  String?    // Atribut medali (opsional)
  uraianCapaian           String

  submission              Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([submissionId])
  @@index([indicatorId])
  @@map("indicator_records")
}

// ============================================
// VALIDATION EVIDENCES (Row-level uploaded PDF evidence)
// ============================================

model ValidationEvidence {
  id              String     @id @default(cuid())
  submissionId    String
  formType        String
  recordId        String
  fileName        String
  fileUrl         String
  fileSize        String?
  
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([submissionId, formType, recordId])
  @@index([submissionId])
  @@index([submissionId, formType])
  @@map("validation_evidences")
}

// ============================================
// AUDIT LOG (Security & Tracking)
// ============================================

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      String      // LOGIN, LOGOUT, CREATE_SUBMISSION, UPDATE_STATUS, etc.
  entity      String?     // Submission, User, etc.
  entityId    String?     // ID of affected entity
  ipAddress   String?
  userAgent   String?
  details     Json?       // Additional metadata
  
  // Relations
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Timestamp
  createdAt   DateTime    @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// FILE ATTACHMENTS (Optional - for production)
// ============================================

model FileAttachment {
  id              String   @id @default(cuid())
  submissionId    String
  fileName        String
  filePath        String   // S3 path or local path
  fileSize        Int
  mimeType        String
  fileHash        String   // SHA-256 for integrity
  
  // Timestamps
  createdAt       DateTime @default(now())
  
  @@index([submissionId])
  @@map("file_attachments")
}
