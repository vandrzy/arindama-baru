// Prisma Schema for ARINDAMA Survey Application
// Database: MySQL
// Setup: Production-ready dengan enkripsi password & audit logging

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String   @id @default(cuid())
  nip           String   @unique
  email         String   @unique
  password      String   // Hashed with bcrypt
  nama          String
  role          UserRole @default(OPERATOR)
  jabatan       String   @default("")
  kabupatenKota String   @default("")
  instansi      String   @default("")
  nomorTelepon  String   @default("")
  
  // Relations
  auditLogs   AuditLog[]
  respondens  Responden[]
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
  
  @@index([email])
  @@index([nip])
  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum RecordStatus {
  MENUNGGU_REVIEW   @map("Menunggu Review")
  REVISI            @map("Revisi")
  SAH_TERVERIFIKASI @map("Sah & Terverifikasi")
  SAH               @map("Sah")
  DISETUJUI         @map("Disetujui")
}

enum JenisKelamin {
  LAKI_LAKI @map("Laki-laki")
  PEREMPUAN @map("Perempuan")
}

// ============================================
// INDICATOR RECORDS (Form Indikator 1 - 8)
// ============================================

model IndicatorRecord {
  id                     String       @id @default(cuid())
  indicatorId            Int          // 1 - 8
  namaKegiatan           String
  cabangOlahraga         String
  tingkatPenyelenggaraan String
  sumberPendanaan        String
  medali                 String?      // Atribut medali (opsional)
  uraianCapaian          String
  status                 RecordStatus @default(MENUNGGU_REVIEW)

  respondenId            String?
  responden              Responden?   @relation(fields: [respondenId], references: [id], onDelete: Cascade)

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([indicatorId])
  @@index([respondenId])
  @@map("indicator_records")
}

// ============================================
// VALIDATION EVIDENCES (Row-level uploaded PDF evidence)
// ============================================

model ValidationEvidence {
  id           String     @id @default(cuid())
  respondenId  String
  formType     String
  recordId     String
  fileName     String
  fileUrl      String
  fileSize     String?
  
  responden    Responden  @relation(fields: [respondenId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([respondenId, formType, recordId])
  @@map("validation_evidences")
}

// ============================================
// AUDIT LOG (Security & Tracking)
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // LOGIN, LOGOUT, CREATE_SUBMISSION, UPDATE_STATUS, etc.
  entity    String?  // Submission, User, etc.
  entityId  String?  // ID of affected entity
  ipAddress String?
  userAgent String?
  details   Json?    // Additional metadata
  
  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Timestamp
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// FILE ATTACHMENTS (Optional - for production)
// ============================================

model FileAttachment {
  id           String     @id @default(cuid())
  respondenId  String
  fileName     String
  filePath     String     // S3 path or local path
  fileSize     Int
  mimeType     String
  fileHash     String     // SHA-256 for integrity
  
  responden    Responden  @relation(fields: [respondenId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt    DateTime   @default(now())
  
  @@index([respondenId])
  @@map("file_attachments")
}

// ============================================
// DYNAMIC WEIGHT MATRIX (Bobot Dinamis)
// ============================================

model DynamicWeight {
  id          String   @id @default(cuid())
  pilar       String   @default("PRESTASI") // "PRESTASI", "DISABILITAS", "REKREASI"
  tingkat     String   // "Internasional", "Nasional", "Provinsi"
  emas        Int      @default(100)
  perak       Int      @default(75)
  perunggu    Int      @default(50)
  partisipasi Int      @default(25)
  updatedAt   DateTime @updatedAt

  @@unique([pilar, tingkat])
  @@map("dynamic_weights")
}

// ============================================
// RESPONDEN
// ============================================

model Responden {
  id             String       @id @default(cuid())
  nik            String       @unique
  nama           String
  jenisKelamin   JenisKelamin @default(LAKI_LAKI)
  tanggalLahir   DateTime
  kabupatenKota  String
  kecamatan      String
  cabangOlahraga String
  nomorTelepon   String

  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  indicatorRecords    IndicatorRecord[]
  validationEvidences ValidationEvidence[]
  fileAttachments     FileAttachment[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("responden")
}


